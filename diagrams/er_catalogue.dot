digraph er_catalogue {
  rankdir=TB; splines=true; nodesep=0.4; ranksep=0.55; pad=0.15;
  graph [fontname="DejaVu Sans"]; node [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, color="#44546A", fontcolor="#1F3A5F", arrowsize=0.9, penwidth=1.0];
  skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>skill_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">skill_name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">category</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">is_active</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">BOOLEAN</FONT></TD></TR></TABLE>>];
  career_interests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>career_interests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>interest_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">interest_name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">is_active</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">BOOLEAN</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 1 more columns</I></FONT></TD></TR></TABLE>>];
  student_skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>student_skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>student_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>skill_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">proficiency_level</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">is_focus</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">BOOLEAN</FONT></TD></TR></TABLE>>];
  mentor_expertise [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>mentor_expertise</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>mentor_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>skill_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">expertise_level</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(30)</FONT></TD></TR></TABLE>>];
  student_interests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>student_interests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>student_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>interest_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR></TABLE>>];
  mentor_interests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#F6E3B4"><FONT COLOR="#5B3A06"><B>mentor_interests</B></FONT> (added)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>mentor_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>interest_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR></TABLE>>];
  student_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>student_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>student_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>see accounts diagram</I></FONT></TD></TR></TABLE>>];
  mentor_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>mentor_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>mentor_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>see accounts diagram</I></FONT></TD></TR></TABLE>>];
  student_profiles -> student_skills [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  skills -> student_skills [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  mentor_profiles -> mentor_expertise [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  skills -> mentor_expertise [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  student_profiles -> student_interests [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  career_interests -> student_interests [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  mentor_profiles -> mentor_interests [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
  career_interests -> mentor_interests [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", taillabel="", fontsize=8];
}