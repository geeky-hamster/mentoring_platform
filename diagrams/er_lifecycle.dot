digraph er_lifecycle {
  rankdir=TB; splines=true; nodesep=0.4; ranksep=0.55; pad=0.15;
  graph [fontname="DejaVu Sans"]; node [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, color="#44546A", fontcolor="#1F3A5F", arrowsize=0.9, penwidth=1.0];
  mentoring_requests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>mentoring_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>request_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">student_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">mentor_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">expires_at</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">TIMESTAMPTZ</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  mentorships [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>mentorships</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>mentorship_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">request_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">student_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">mentor_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">ended_by</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 5 more columns</I></FONT></TD></TR></TABLE>>];
  availability_slots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>availability_slots</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>slot_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">mentor_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">start_time</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">end_time</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">TIMESTAMPTZ</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 2 more columns</I></FONT></TD></TR></TABLE>>];
  sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>session_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">mentorship_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">student_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">mentor_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">slot_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">cancelled_by</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 8 more columns</I></FONT></TD></TR></TABLE>>];
  feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>feedback</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>feedback_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">session_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">submitted_by</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">rating</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">INTEGER</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 2 more columns</I></FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>user_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>see accounts diagram</I></FONT></TD></TR></TABLE>>];
  student_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>student_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>see accounts diagram</I></FONT></TD></TR></TABLE>>];
  mentor_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>mentor_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>see accounts diagram</I></FONT></TD></TR></TABLE>>];
  student_profiles -> mentoring_requests [dir=both, arrowtail=teetee, arrowhead=crowodot, label="sends", taillabel="", fontsize=8];
  mentor_profiles -> mentoring_requests [dir=both, arrowtail=teetee, arrowhead=crowodot, label="receives", taillabel="", fontsize=8];
  mentoring_requests -> mentorships [dir=both, arrowtail=teetee, arrowhead=teeodot, label="created from", taillabel="", fontsize=8];
  student_profiles -> mentorships [dir=both, arrowtail=teetee, arrowhead=crowodot, label="learns in", taillabel="", fontsize=8];
  mentor_profiles -> mentorships [dir=both, arrowtail=teetee, arrowhead=crowodot, label="guides in", taillabel="", fontsize=8];
  users -> mentorships [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="ended by", taillabel="", fontsize=8];
  mentor_profiles -> availability_slots [dir=both, arrowtail=teetee, arrowhead=crowodot, label="publishes", taillabel="", fontsize=8];
  mentorships -> sessions [dir=both, arrowtail=teetee, arrowhead=crowodot, label="contains", taillabel="", fontsize=8];
  availability_slots -> sessions [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="booked into", taillabel="", fontsize=8];
  users -> sessions [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="cancelled by", taillabel="", fontsize=8];
  sessions -> feedback [dir=both, arrowtail=teetee, arrowhead=crowodot, label="rates", taillabel="", fontsize=8];
  users -> feedback [dir=both, arrowtail=teetee, arrowhead=crowodot, label="written by", taillabel="", fontsize=8];
  {rank=same; student_profiles; mentor_profiles;}
  {rank=same; sessions; users;}
}