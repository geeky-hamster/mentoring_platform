digraph er_accounts {
  rankdir=TB; splines=true; nodesep=0.4; ranksep=0.55; pad=0.15;
  graph [fontname="DejaVu Sans"]; node [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, color="#44546A", fontcolor="#1F3A5F", arrowsize=0.9, penwidth=1.0];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>user_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">full_name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">email</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">role</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">account_status</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  student_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>student_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>student_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_role</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">programme_stage</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">expected_graduation_year</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">profile_completed</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">BOOLEAN</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 5 more columns</I></FONT></TD></TR></TABLE>>];
  mentor_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>mentor_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>mentor_profile_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_role</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">mentor_type</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">is_available</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">max_active_mentees</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">profile_status</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">reviewed_by</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 10 more columns</I></FONT></TD></TR></TABLE>>];
  notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>notification_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">notification_type</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">is_read</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">BOOLEAN</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  refresh_tokens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#F6E3B4"><FONT COLOR="#5B3A06"><B>refresh_tokens</B></FONT> (added)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>token_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">family_id</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">expires_at</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">revoked_at</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">TIMESTAMPTZ</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  audit_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3A5F"><TR><TD COLSPAN="3" BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">PK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>audit_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">FK</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">actor_user_id</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#6B7686">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">action</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">entity_type</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"></TD><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#6B7686">TIMESTAMPTZ</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#6B7686"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  users -> student_profiles [dir=both, arrowtail=teetee, arrowhead=teeodot, label="has student profile", taillabel="", fontsize=8];
  users -> mentor_profiles [dir=both, arrowtail=teetee, arrowhead=teeodot, label="has mentor profile", taillabel="", fontsize=8];
  users -> mentor_profiles [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="reviewed by (admin)", taillabel="", fontsize=8];
  users -> notifications [dir=both, arrowtail=teetee, arrowhead=crowodot, label="addressed to", taillabel="", fontsize=8];
  users -> audit_logs [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="performed by", taillabel="", fontsize=8];
  users -> refresh_tokens [dir=both, arrowtail=teetee, arrowhead=crowodot, label="issued to", taillabel="", fontsize=8];
  {rank=same; student_profiles; mentor_profiles;}
  {rank=same; notifications; refresh_tokens; audit_logs;}
  student_profiles -> notifications [style=invis];
  mentor_profiles -> audit_logs [style=invis];
}