# Copy to .env and adjust. Keys follow design report Section 11.5.
DATABASE_URL=postgresql+psycopg://mentoring:mentoring_dev_pw@localhost:5433/mentoring
JWT_SECRET_KEY=change-me-32-bytes-minimum-per-environment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REQUEST_EXPIRY_DAYS=14
COOLDOWN_DAYS=30
FEEDBACK_WINDOW_DAYS=14
MAX_PENDING_REQUESTS=3
MATCH_W_SKILLS=0.50
MATCH_W_INTERESTS=0.30
MATCH_W_AVAILABILITY=0.20
CORS_ORIGINS=http://localhost:5173
EMAIL_ENABLED=false
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=admin-password-123
JOBS_ENABLED=true
ENV=local
