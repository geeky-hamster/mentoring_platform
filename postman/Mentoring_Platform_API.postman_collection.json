{
  "info": {
    "name": "Mentoring Platform API",
    "description": "Complete Postman collection for the IITM Student Mentoring and Career Support Platform. Implements all 58 endpoints from the OpenAPI 3.0.3 contract (api-spec.yaml).\n\nBase URL: http://localhost:8000/api/v1\n\nAuthentication: JWT Bearer tokens with HTTP-only refresh cookie rotation.\n- Run Login first to populate accessToken and refreshToken environment variables\n- Tokens auto-refresh on 401 via pre-request script\n- Refresh cookie path: /api/v1/auth\n\nResponse Envelopes:\n- Success: { data: {...}, meta: {page, page_size, total, total_pages} }\n- Error: { error: {code, message, details[], request_id} }\n\nRate Limits (per IP):\n- Login/Register: 10/min\n- Forgot Password: 5/min\n- Mentoring Requests: 10/min\n\nDemo Accounts (password: correct-horse-battery-9):\n- Admin: admin@example.org / admin-password-123\n- Student: asha.menon@example.org\n- Mentor: rohan.iyer@example.org\n- Mentor: meera.nair@example.org\n- Mentor: karthik.rao@example.org\n- Mentor (at capacity): divya.sharma@example.org\n- Mentor (paused): sanjay.patel@example.org\n- Mentor (pending): lakshmi.pillai@example.org\n- Student (has mentorship): vikram.shah@example.org\n- Student (has mentorship): ravi.kumar@example.org",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "mentoring-platform",
    "_postman_id": "mentoring-platform-api-v1"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token on 401 - runs before each request",
          "const pm = require('postman-collection');",
          "",
          "// Store original request for retry",
          "if (!pm.request.headers.has('Authorization') && pm.environment.get('accessToken')) {",
          "  pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('accessToken') });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Capture request_id for debugging",
          "const res = pm.response;",
          "if (res.headers.has('x-request-id')) {",
          "  pm.environment.set('requestId', res.headers.get('x-request-id'));",
          "}",
          "",
          "// Auto-extract access token from login/refresh responses",
          "if (pm.request.url.path.includes('/auth/login') || pm.request.url.path.includes('/auth/refresh')) {",
          "  try {",
          "    const json = res.json();",
          "    if (json.data?.access_token) {",
          "      pm.environment.set('accessToken', json.data.access_token);",
          "    }",
          "    // Refresh token is in HTTP-only cookie, not in response body",
          "  } catch (e) { /* ignore */ }",
          "}",
          "",
          "// Validate response envelope structure",
          "pm.test('Response has correct envelope', () => {",
          "  const json = res.json();",
          "  if (res.code >= 400) {",
          "    pm.expect(json).to.have.property('error');",
          "    pm.expect(json.error).to.have.property('code');",
          "    pm.expect(json.error).to.have.property('message');",
          "    pm.expect(json.error).to.have.property('request_id');",
          "  } else {",
          "    pm.expect(json).to.have.property('data');",
          "    pm.expect(json).to.have.property('meta');",
          "  }",
          "});"
        ]
      }
    }
  ],
